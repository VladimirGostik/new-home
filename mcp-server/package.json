{
    "name": "new-home-mcp-server",
    "version": "1.1.0",
    "description": "MCP server for the \"Náš nový dom\" shopping-list app (rooms, items, variants, variant comparisons).",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "new-home-mcp-server": "dist/index.js"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "start": "node dist/index.js",
        "dev": "tsc --watch",
        "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
        "pack:mcpb": "node scripts/pack-mcpb.mjs"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.1",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@anthropic-ai/mcpb": "^2.1.2",
        "@types/node": "^22.0.0",
        "typescript": "^5.9.0"
    }
}
